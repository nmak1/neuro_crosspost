[Unit]
Description=AutoPoster scheduler (VK + Telegram cross-posting)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/autoposter
ExecStart=/opt/autoposter/.venv/bin/python /opt/autoposter/main.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
