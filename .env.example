# скопируйте в .env и впишите реальные ключи. сам .env в git не попадает

# ВКонтакте (паблик https://vk.ru/club235314099)
VK_GROUP_ID=235314099
VK_TOKEN=ваш_ключ_группа_с_правами_wall,photos,offline
VK_API_VERSION=5.199

# Telegram канал @nocnnov
TG_BOT_TOKEN=123456:ABC-выданный_botfather_токен
TG_CHAT_ID=@nocnnov

# LLM провайдер (что по умолчанию стоит в config.py, то и крутим)
LLM_PROVIDER=yandex_gpt
YANDEX_API_KEY=ваш_ключ_из_Yandex_Cloud
YANDEX_FOLDER_ID=id_каталога
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# расписание: 1 пост в день, в выбранные дни недели (2 раза в неделю по умолчанию)
POST_TIME_MSK=10:00
POST_DAYS=mon,thu
TIMEZONE=Europe/Moscow

# алерты об ошибках ботом в личку разработчику
ALERT_TG_CHAT_ID=ваш_user_id

# логирование
LOG_LEVEL=INFO
